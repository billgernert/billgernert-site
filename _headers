# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# The landing page is near-self-contained: inline CSS, inline SVG logo, data: favicon with a
# conventional same-origin ICO fallback, and one
# same-origin script (assets/motion.js, the generated entrance-motion engine). script-src stays
# 'self' with no 'unsafe-inline', so the engine is a file and only its stylesheet is inline.
# Interior pages link the shared stylesheet (assets/site.css), so style-src includes 'self'.
# The only external requests are the site's brand fonts (Share Tech Mono + Exo 2) from
# Google Fonts, so the CSP allows exactly those two hosts and nothing else.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://status.billgernert.com https://topology-feed.billgernert.com; frame-src 'self' https://status.billgernert.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/map/embed/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://status.billgernert.com https://topology-feed.billgernert.com; frame-src 'self' https://status.billgernert.com; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# The public Jenkins replica embeds only within this site and reads its dated snapshot.
/projects/jenkins/activity/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# Original trip interfaces: allow their public maps, venue photos and visitor-triggered place search.
/projects/trip-planners/*
  ! Content-Security-Policy
  ! Permissions-Policy
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.open-meteo.com https://nominatim.openstreetmap.org; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
